<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="Xunit" />
    <Using Include="System.Numerics" />
    <Using Include="PeakXR.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PeakXR.Core/PeakXR.Core.csproj" />
  </ItemGroup>

  <!-- The preloader's file sync is plain IO, tested on a temp folder. BepInEx's NuGet package has no runtime
       assembly, so the source is compiled here against a stub ManualLogSource (BepInExLogStub.cs). -->
  <ItemGroup>
    <Compile
      Include="../../src/PeakXR.Preloader/RuntimeInstaller.cs"
      Link="Preloader/RuntimeInstaller.cs"
    />
  </ItemGroup>
</Project>
