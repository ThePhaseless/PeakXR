<Project>
  <PropertyGroup>
    <!-- The one mod version: plugin, preloader, Thunderstore manifest (tools/package.sh) and the vX.Y.Z release tag. -->
    <Version>0.1.1</Version>
    <!-- Pinned, not "latest": a future SDK must not silently move the language level (see docs/research/stack.md). -->
    <LangVersion>14.0</LangVersion>
    <!-- Every CA rule at warning; .editorconfig turns off, with a reason, the ones that fight Unity/Harmony/BepInEx. -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only runs in a build that writes XML docs; CS1591 (missing docs) is off in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CI-like builds (CI=true) turn every analyzer warning into an error. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Release DLLs and PDBs carry no build-machine paths (PDB path, CallerFilePath, source paths, SourceLink map):
       in a git checkout the SDK's SourceLink maps the repo to /_/; without git, PathMap does. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="Exists('$(MSBuildThisFileDirectory).git')"
      >true</ContinuousIntegrationBuild>
    <PathMap Condition="!Exists('$(MSBuildThisFileDirectory).git')"
      >$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <!-- Bug and code-smell analyzers for every project, tests included. -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>

  <!-- Analyzers for every project except the test project. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.317" PrivateAssets="all" />
  </ItemGroup>

  <!-- Unity analyzers for the game-side plugins (PeakXR, the MpObserver test plugin); Harmony's for PeakXR's patches. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PeakXR' Or '$(MSBuildProjectName)' == 'MpObserver'">
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.28.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PeakXR'">
    <PackageReference Include="BUTR.Harmony.Analyzer" Version="1.0.1.50" PrivateAssets="all" />
  </ItemGroup>

  <!-- AI disclosure that Thunderstore asks for in shipped assemblies (wiki.thunderstore.io/llms-and-ai-generated-files). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PeakXR' Or '$(MSBuildProjectName)' == 'PeakXR.Core' Or '$(MSBuildProjectName)' == 'PeakXR.Preloader'">
    <AssemblyMetadata
      Include="AI_Assisted_Creation"
      Value="This assembly was partially or fully created with the assistance of Generative AI"
    />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="Anthropic" />
  </ItemGroup>

  <!-- Language polyfills for netstandard2.x (IsExternalInit, CallerArgumentExpression, ...), as internal source. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PeakXR' Or '$(MSBuildProjectName)' == 'PeakXR.Core' Or '$(MSBuildProjectName)' == 'PeakXR.Preloader'">
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
